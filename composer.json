{
    "name": "adamczykpiotr/laravel-ultimate-formatter",
    "description": "Ultimate code formatter for Laravel, taking care of everything",
    "keywords": [
        "AdamczykPiotr",
        "laravel",
        "ultimate-formatter"
    ],
    "homepage": "https://github.com/adamczykpiotr/laravel-ultimate-formatter",
    "license": "MIT",
    "authors": [
        {
            "name": "Piotr Adamczyk",
            "email": "admin@adamczykpiotr.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "driftingly/rector-laravel": "^2.7",
        "fidry/cpu-core-counter": "^1.3",
        "friendsofphp/php-cs-fixer": "^3.64",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "larastan/larastan": "^3.13",
        "phpat/phpat": "^0.12.5",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8",
        "spatie/laravel-package-tools": "^1.16",
        "spaze/phpstan-disallowed-calls": "^4.15",
        "symfony/console": "^7.4||^8.0",
        "symfony/filesystem": "^7.4||^8.0",
        "symfony/process": "^7.4||^8.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0.0||^10.0.0",
        "phpstan/extension-installer": "^1.4",
        "phpunit/phpunit": "^11.0||^12.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1"
    },
    "suggest": {
        "barryvdh/laravel-ide-helper": "Regenerates model docblocks when running format with --models"
    },
    "bin": [
        "bin/ultimate-formatter"
    ],
    "autoload": {
        "psr-4": {
            "AdamczykPiotr\\UltimateFormatter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdamczykPiotr\\UltimateFormatter\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=2G",
        "check": "@php bin/ultimate-formatter check",
        "format": "@php bin/ultimate-formatter format",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html build/coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AdamczykPiotr\\UltimateFormatter\\UltimateFormatterServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
