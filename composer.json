{
    "name": "adamczykpiotr/laravel-ultimate-formatter",
    "description": "Ultimate code formatter for Laravel, taking care of everything",
    "keywords": [
        "AdamczykPiotr",
        "laravel",
        "ultimate-formatter"
    ],
    "homepage": "https://github.com/adamczykpiotr/laravel-ultimate-formatter",
    "license": "MIT",
    "authors": [
        {
            "name": "Piotr Adamczyk",
            "email": "admin@adamczykpiotr.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0",
        "phpstan/extension-installer": "^1.4",
        "phpunit/phpunit": "^11.0||^12.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AdamczykPiotr\\UltimateFormatter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdamczykPiotr\\UltimateFormatter\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html build/coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AdamczykPiotr\\UltimateFormatter\\UltimateFormatterServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
